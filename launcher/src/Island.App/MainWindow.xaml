<Window x:Class="Island.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Island.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="岛屿启动器 · Island Launcher" Style="{StaticResource {x:Type Window}}" Icon="Island.ico" Width="1240" Height="830" MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" Closing="OnClosing" SizeChanged="AdaptLayout" StateChanged="UpdateWindowState">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
 <local:MaterialBorder x:Name="WindowSurface" Area="Window" CornerRadius="14" Background="{DynamicResource WindowBackground}" SizeChanged="UpdateWindowOutline"><Grid Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="WindowTitleBar" Background="Transparent">
   <StackPanel x:Name="WindowTrafficLights" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MacCloseButton" Style="{StaticResource TrafficLight}" Background="#FF5F57" BorderBrush="#CD4944" Foreground="#641B17" Content="×" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="红色：关闭窗口" />
    <Button x:Name="MacMinimizeButton" Style="{StaticResource TrafficLight}" Background="#FEBC2E" BorderBrush="#D69B25" Foreground="#795300" Content="−" Click="Minimize" ToolTip="最小化" AutomationProperties.Name="黄色：最小化窗口" />
    <Button x:Name="MacMaximizeButton" Style="{StaticResource TrafficLight}" Background="#28C840" BorderBrush="#20A834" Foreground="#075717" Content="+" Click="Maximize" ToolTip="最大化 / 还原" AutomationProperties.Name="绿色：最大化或还原窗口" />
   </StackPanel>
   <TextBlock x:Name="WindowEditionLabel" Text="MINECRAFT JAVA EDITION" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="88,0,0,0" VerticalAlignment="Center" />
   <StackPanel x:Name="WindowControls" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="WindowMinimizeButton" Style="{StaticResource Quiet}" Content="─" Width="43" Click="Minimize" Padding="0" ToolTip="最小化" AutomationProperties.Name="最小化窗口" /><Button x:Name="WindowMaximizeButton" Style="{StaticResource Quiet}" Content="□" Width="43" Click="Maximize" Padding="0" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原窗口" /><Button x:Name="WindowCloseButton" Style="{StaticResource Quiet}" Content="×" Width="43" FontSize="20" Click="CloseWindow" Padding="0" ToolTip="关闭" AutomationProperties.Name="关闭窗口" /></StackPanel>
  </Grid>
  <Grid x:Name="ShellModules" Grid.Row="1" Margin="12,0,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <local:MaterialBorder Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Area="Sidebar" x:Name="SidebarSurface">
   <Grid><Grid.RowDefinitions><RowDefinition Height="106" /><RowDefinition Height="*" /><RowDefinition Height="84" /><RowDefinition Height="16" /></Grid.RowDefinitions>
    <StackPanel x:Name="SidebarBrand" Margin="28,22,22,0" VerticalAlignment="Top" AutomationProperties.Name="ISLAND Launcher">
     <TextBlock x:Name="BrandName" Text="ISLAND" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold" TextWrapping="NoWrap" />
     <TextBlock x:Name="BrandSubtitle" Text="Launcher" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Muted}" Margin="1,2,0,0" TextWrapping="NoWrap" />
    </StackPanel>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="你的空间" FontSize="10" Foreground="{DynamicResource Muted}" Margin="29,5,0,12" />
     <RadioButton x:Name="NavLibrary" Style="{StaticResource Nav}" GroupName="Pages" Tag="Library" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" /><TextBlock Text="我的实例" /></StackPanel></RadioButton>
     <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" GroupName="Pages" Tag="Accounts" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" /><TextBlock Text="玩家账号" /></StackPanel></RadioButton>
     <RadioButton x:Name="NavDownloads" Style="{StaticResource Nav}" GroupName="Pages" Tag="Downloads" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" /><TextBlock x:Name="DownloadNavLabel" Text="下载中心" /></StackPanel></RadioButton>
     <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" GroupName="Pages" Tag="Logs" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" /><TextBlock Text="运行日志" /></StackPanel></RadioButton>
     <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="Pages" Tag="Settings" Checked="Navigate" Click="ReturnToSettings"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" /><TextBlock Text="启动器设置" /></StackPanel></RadioButton>
     <Border Height="1" Background="{DynamicResource Line}" Margin="28,18,28,10" />
    </StackPanel><local:SkinPreview3D x:Name="SidebarDoll" Grid.Row="1" Height="220" Margin="16,0,16,4" VerticalAlignment="Bottom" /></Grid>
    <Grid Grid.Row="2" Margin="20,10,20,0" VerticalAlignment="Stretch">
     <Button x:Name="SidebarAccountButton" MinHeight="58" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Click="OpenAccounts" Background="{DynamicResource AccentSoft}" BorderThickness="0" Padding="10,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Background="{DynamicResource Surface}" CornerRadius="6" Width="32" Height="32"><Image x:Name="SidebarAvatar" Width="28" Height="28" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SidebarPlayer" Text="添加玩家" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock x:Name="SidebarAccountType" Text="开始你的旅程" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" /></StackPanel></Grid></Button>
    </Grid>
    <TextBlock Grid.Row="3" Text="ISLAND LAUNCHER   /   0.10.22" FontSize="8" Foreground="{DynamicResource Muted}" Margin="25,0,0,0" VerticalAlignment="Center" />
   </Grid>
  </local:MaterialBorder>
  <local:MaterialBorder x:Name="MainContentSurface" Grid.Column="2" Area="Content" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
   <Grid Margin="24,16,24,16"><Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="LibraryPage" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="180" /><RowDefinition Height="63" /><RowDefinition Height="*" /><RowDefinition Height="84" /></Grid.RowDefinitions>
     <local:MaterialBorder Background="{DynamicResource HeroBackground}" CornerRadius="14" ClipToBounds="True" SizeChanged="ClipHero" Area="Hero" x:Name="RecentHero">
      <Grid>
       
       <Grid Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
         <TextBlock Text="上次游玩" Foreground="{DynamicResource HeroMuted}" FontSize="12" />
         <TextBlock x:Name="RecentInstanceName" Text="还没有游玩记录" Foreground="{DynamicResource HeroText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
         <TextBlock x:Name="RecentInstanceDetail" Foreground="{DynamicResource HeroMuted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
         <Button x:Name="ContinueButton" Content="▶  一键继续" Style="{StaticResource Primary}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="ContinueGame" />
        </StackPanel>
        <local:MaterialBorder Grid.Column="1" Background="{DynamicResource HeroSurface}" BorderBrush="{DynamicResource HeroBorder}" BorderThickness="1" CornerRadius="11" Padding="14" Height="116" VerticalAlignment="Center" Area="RecentMap" x:Name="RecentMapSurface" SizeChanged="ClipRecentWorld"><local:MaterialBorder.ContextMenu><ContextMenu><MenuItem Header="单独设置地图卡片外观" Click="EditRecentMapAppearance"/></ContextMenu></local:MaterialBorder.ContextMenu>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="RecentWorldCaption" Text="上次游玩的地图" Foreground="{DynamicResource HeroMuted}" FontSize="10" /><TextBlock x:Name="RecentWorldName" Text="还没有地图记录" Foreground="{DynamicResource HeroText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,10,0,0" /><TextBlock x:Name="RecentPlayedTime" Text="游玩后会在这里显示" Foreground="{DynamicResource HeroMuted}" FontSize="10" Margin="0,12,0,0" /></StackPanel>
          <Border x:Name="RecentWorldThumbnailFrame" Grid.Column="1" Width="64" Height="64" Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="8" Visibility="Collapsed" SizeChanged="ClipWorldThumbnail"><Image x:Name="RecentWorldThumbnail" Stretch="UniformToFill" IsHitTestVisible="False" /></Border>
         </Grid>
        </local:MaterialBorder>
       </Grid>
      </Grid>
     </local:MaterialBorder>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="64" /><ColumnDefinition Width="146" /><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="FolderTabsScroll" VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollFolderTabs">
       <StackPanel Orientation="Horizontal"><RadioButton x:Name="FilterFavorites" Content="☆ 收藏" GroupName="LibraryFolders" Style="{StaticResource Filter}" Checked="ShowFavoriteFolders" /><ItemsControl x:Name="FolderTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
      </ScrollViewer>
      <Button x:Name="ManageFoldersButton" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="" Style="{StaticResource Quiet}" Padding="6" Height="32" VerticalAlignment="Center" ToolTip="管理目录名称" Click="ManageGameFolders" />
      <TextBlock x:Name="InstanceCount" Grid.Column="2" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <Grid Grid.Column="3" VerticalAlignment="Center"><TextBox x:Name="SearchBox" MinHeight="34" Padding="11,6" ToolTip="搜索实例名称、版本或加载器" TextChanged="SearchChanged" /><TextBlock Text="搜索你的世界…" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Grid.Column="4" Content="↻" Click="RefreshLibrary" Style="{StaticResource Quiet}" FontSize="19" Padding="6,4" VerticalAlignment="Center" ToolTip="刷新实例列表" />
      <Button x:Name="AddInstanceButton" Grid.Column="5" Content="＋ 添加实例" Style="{StaticResource Primary}" Click="AddInstance" Margin="10,0,0,0" Padding="12,8" VerticalAlignment="Center" />
     </Grid>
     <Grid Grid.Row="2"><ListBox x:Name="InstanceList" SelectionChanged="SelectInstance" MouseDoubleClick="EditInstance" KeyDown="InstanceKeyDown" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><local:AdaptiveCardPanel Margin="6,8,6,8" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0" /><EventSetter Event="Loaded" Handler="InitializeInstanceMenu" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Height="155" Margin="17,15"><Grid.RowDefinitions><RowDefinition Height="45" /><RowDefinition Height="*" /><RowDefinition Height="22" /></Grid.RowDefinitions><Border Width="42" Height="42" HorizontalAlignment="Left" Background="{Binding IconBackground}" CornerRadius="11"><Grid><local:InstanceGlyph Kind="{Binding Loader}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"><local:InstanceGlyph.Style><Style TargetType="local:InstanceGlyph"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></local:InstanceGlyph.Style></local:InstanceGlyph><Image Source="{Binding Icon}" Stretch="UniformToFill" /></Grid></Border><Button x:Name="CardFavoriteButton" AutomationProperties.Name="{Binding FavoriteTip}" Content="{Binding FavoriteGlyph}" Tag="{Binding}" ToolTip="{Binding FavoriteTip}" Click="ToggleCardFavorite" Style="{StaticResource CardFavorite}" Width="34" Height="34" Padding="0" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Top" /><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Text="{Binding CardSubtitle}" ToolTip="{Binding CardSubtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Hint}" Margin="0,6,0,0" /></StackPanel><Grid Grid.Row="2"><TextBlock Text="{Binding LastPlayed}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" /><TextBlock Text="{Binding Loader}" FontSize="10" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyTitle" Text="给第一个世界留个位置" FontSize="17" HorizontalAlignment="Center" Margin="0,14,0,0" /><TextBlock x:Name="EmptyDescription" Text="创建一个新实例，或导入下载器 / 其他启动器的 .minecraft 目录。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,7,0,0" /><Button x:Name="EmptyCreateButton" Content="添加第一个实例  →" Style="{StaticResource Quiet}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="AddInstance" /></StackPanel>
     </Grid>
     <local:LaunchBarPresenter x:Name="LaunchBarHost" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Height="84" Panel.ZIndex="10"><local:MaterialBorder Background="{DynamicResource AccentSoft}" CornerRadius="11" Padding="18,13,13,13" Margin="0,10,0,0" Area="LaunchBar" x:Name="LaunchBarSurface"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="SelectedName" Text="选择一个实例" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock x:Name="SelectedDetail" Text="每个实例都有独立的存档、模组与配置" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel><Button x:Name="LaunchButton" Grid.Column="1" Content="▶  启动游戏" Style="{StaticResource Primary}" Padding="25,12" VerticalAlignment="Center" Click="LaunchGame" IsEnabled="False" /></Grid></local:MaterialBorder></local:LaunchBarPresenter>
    </Grid>
    <Grid x:Name="AccountsPage" Grid.Row="1" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <local:MaterialBorder Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22" Area="Panels"><StackPanel>
      <TextBlock Text="玩家账号" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="选择玩家身份，配置专属皮肤与头像。" Style="{StaticResource Hint}" Margin="0,10,0,18" />
      <StackPanel Orientation="Horizontal"><Button Content="＋  登录 Microsoft" Style="{StaticResource Primary}" Click="AddMicrosoft" /><Button Content="添加本地账号" Margin="10,0,0,0" Click="AddOffline" /></StackPanel>
     </StackPanel></local:MaterialBorder>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="NoAccounts" Text="还没有玩家账号。添加一个，旅程就开始了。" Style="{StaticResource Hint}" Margin="8,12" />
      <ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate>
       <local:MaterialBorder Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20" Area="Panels"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}" CornerRadius="8"><Image Source="{Binding Avatar}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
        <Button Grid.Column="2" Content="配置皮肤" Tag="{Binding Account}" Click="ConfigureSkin" VerticalAlignment="Center" Padding="12,9" />
        <Button Grid.Column="3" Content="设为当前" Tag="{Binding Account}" Click="UseAccount" VerticalAlignment="Center" Padding="12,9" Margin="8,0,0,0" />
        <Button Grid.Column="4" Content="移除" Style="{StaticResource Quiet}" Tag="{Binding Account}" Click="RemoveAccount" VerticalAlignment="Center" Padding="12,9" Margin="4,0,0,0" />
       </Grid></local:MaterialBorder>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Grid>
    <local:DownloadCenter x:Name="DownloadCenterView" Grid.Row="1" Visibility="Collapsed" />
    <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="游戏输出和启动诊断会保存在本机。" Style="{StaticResource Hint}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="打开日志目录" Click="OpenLogs" Padding="12,7" /><Button Content="复制" Click="CopyLogs" Padding="12,7" Margin="7,0,0,0" /></StackPanel></Grid><TextBox Grid.Row="1" x:Name="LogBox" Background="{DynamicResource HeroBackground}" Foreground="{DynamicResource HeroMuted}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18" AcceptsReturn="True" /></Grid>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
     <local:MaterialBorder x:Name="PresetThemesSection" Style="{StaticResource Card}" Area="Panels" Margin="0,0,0,16"><StackPanel>
      <DockPanel><Button x:Name="OpenAppearanceButton" DockPanel.Dock="Right" Content="打开外观设置  →" Style="{StaticResource Primary}" Click="OpenAppearance" VerticalAlignment="Center" Margin="20,0,0,0" /><StackPanel><TextBlock Text="外观设置" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="在交互预览中配置自定义颜色、背景、透明度与材质。" Style="{StaticResource Hint}" Margin="0,8,0,0" /></StackPanel></DockPanel>
      <TextBlock Text="预设主题" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,10" /><WrapPanel x:Name="ThemePresetButtons" />
      <CheckBox x:Name="HideSidebarDollBox" Content="隐藏主界面纸娃娃" VerticalAlignment="Center" Checked="ChangeSidebarDollVisibility" Unchecked="ChangeSidebarDollVisibility" Margin="0,10,0,0" />
      <WrapPanel Margin="0,16,0,4"><TextBlock Text="底部启动栏" VerticalAlignment="Center" Margin="0,0,18,0" /><RadioButton x:Name="LaunchBarAlwaysBox" Style="{StaticResource Filter}" Content="常驻显示" GroupName="LaunchBarMode" Margin="0,0,18,0" Checked="ChangeLibraryEffects" /><RadioButton x:Name="LaunchBarApproachBox" Style="{StaticResource Filter}" Content="鼠标靠近时弹出" GroupName="LaunchBarMode" Checked="ChangeLibraryEffects" /></WrapPanel>
      <TextBlock Text="卡片动画" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,10" />
      <WrapPanel x:Name="CardAnimationChoices" />
      <TextBlock x:Name="CardAnimationDescription" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" />
      <TextBlock x:Name="QuickAppearanceStatus" Text="预设主题、纸娃娃与卡片动画即点即用，自动保存。自定义微调在外观设置中保存后生效。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
     </StackPanel></local:MaterialBorder>
     <local:MaterialBorder Style="{StaticResource Card}" Margin="0,0,0,16" Area="Panels"><StackPanel><TextBlock Text="游戏存放位置" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="当前文件夹的安装位置。保存新目录后会增加一个文件夹标签，也可在实例页批量导入。" Style="{StaticResource Hint}" Margin="0,6,0,15" /><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="BrowseRoot" Margin="10,0,0,0" /><TextBox x:Name="RootBox" /></DockPanel></StackPanel></local:MaterialBorder>
     <local:MaterialBorder Style="{StaticResource Card}" Margin="0,0,0,16" Area="Panels"><StackPanel>
      <Grid><TextBlock Text="全局 Java" FontSize="17" FontWeight="SemiBold" /><Button x:Name="DetectJavaButton" Content="重新检测" Click="DetectJava" HorizontalAlignment="Right" Padding="12,7" /></Grid>
      <TextBlock Text="自动选择会根据游戏元数据匹配 64 位 Java。也可手动指定 java.exe。" Style="{StaticResource Hint}" Margin="0,8,0,13" />
      <DockPanel><Button DockPanel.Dock="Right" Content="选择 Java" Click="BrowseJava" Margin="10,0,0,0" /><ComboBox x:Name="JavaBox" IsEditable="True" IsTextSearchEnabled="False" DisplayMemberPath="Display" SelectedValuePath="Path" /></DockPanel>
      <TextBlock x:Name="JavaStatus" Style="{StaticResource Hint}" Margin="0,9,0,0" />
     </StackPanel></local:MaterialBorder>
     <local:MaterialBorder x:Name="GlobalMemoryCard" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,6,16,14" Area="Panels"><StackPanel>
      <local:MemoryAllocationEditor x:Name="GlobalMemoryEditor" />
        <Grid x:Name="MemoryOptimizationRow" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <CheckBox x:Name="CleanMemoryBeforeLaunchBox" Content="启动游戏前进行内存优化" Click="ToggleLaunchMemoryCleanup" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="点击即保存。等待清理结束后再启动 Minecraft，弹窗显示本次可用内存净增量；可能请求 Windows 管理员授权，取消授权会明确提示并跳过清理。" />
         <Button x:Name="CleanMemoryNowButton" Grid.Column="1" Content="立即清理" Click="CleanMemoryNow" Padding="12,5" MinWidth="90" ToolTip="立即清理内存，无需保存设置；可能请求 Windows 管理员授权" />
        </Grid>
      <TextBlock x:Name="MemoryCleanupStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
     </StackPanel></local:MaterialBorder>
     <local:MaterialBorder Style="{StaticResource Card}" Margin="0,0,0,16" Area="Panels"><StackPanel><TextBlock Text="全局 Java 虚拟机设置" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="默认应用于所有版本。右键实例 → 实例管理，可切换为独立设置。" Style="{StaticResource Hint}" Margin="0,8,0,18" /><ContentControl x:Name="JvmHost" /></StackPanel></local:MaterialBorder>
