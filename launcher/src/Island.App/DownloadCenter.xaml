<UserControl x:Class="Island.App.DownloadCenter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Island.App">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,2,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="下载中心" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Destination" Style="{StaticResource Hint}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="导入本地整合包" Click="ImportClick" VerticalAlignment="Center"/></Grid>
  <Border Grid.Row="1" Background="{DynamicResource NoticeBackground}" CornerRadius="8" Padding="12,9" Margin="0,0,0,12"><TextBlock x:Name="AvailabilityNotice" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource NoticeInk}"/></Border>
  <WrapPanel Grid.Row="2" Margin="0,0,0,12"><RadioButton x:Name="GamesTab" Content="下载游戏" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Games" IsChecked="True" Checked="ChangeTab" Margin="0,0,16,0"/><RadioButton x:Name="PacksTab" Content="整合包" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Packs" Checked="ChangeTab" Margin="0,0,16,0"/><RadioButton x:Name="ModsTab" Content="Mod" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Mods" Checked="ChangeTab" Margin="0,0,10,0"/><RadioButton x:Name="ShadersTab" Content="光影" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Shaders" Checked="ChangeTab" Margin="0,0,10,0"/><RadioButton x:Name="ResourcesTab" Content="资源包" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Resources" Checked="ChangeTab" Margin="0,0,10,0"/><RadioButton x:Name="TasksTab" Content="下载任务" Style="{StaticResource CatalogTab}" GroupName="DownloadPages" Tag="Tasks" Checked="ChangeTab"/></WrapPanel>
  <ScrollViewer Grid.Row="3" x:Name="GamesPage" VerticalScrollBarVisibility="Auto"><local:MaterialBorder Area="Panels" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel>
   <Grid><TextBlock Text="安装 Minecraft" FontSize="17" FontWeight="SemiBold"/><Button x:Name="ReloadGamesButton" Content="刷新版本" HorizontalAlignment="Right" Click="ReloadGames"/></Grid>
   <TextBlock Text="游戏版本" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GameVersions" DisplayMemberPath="Id" IsEditable="True" IsReadOnly="False" IsTextSearchEnabled="True" SelectionChanged="GameSelected" Margin="0,0,14,0"/><CheckBox x:Name="ShowSnapshots" Grid.Column="1" Content="快照与历史版本" VerticalAlignment="Center" Checked="FilterGames" Unchecked="FilterGames"/></Grid>
   <TextBlock Text="模组加载器" Margin="0,16,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="GameLoader" SelectionChanged="GameSelected"/><ComboBox x:Name="LoaderVersions" Grid.Column="2" DisplayMemberPath="Display"/></Grid>
   <TextBlock Text="新实例名称" Margin="0,16,0,8"/><TextBox x:Name="NewInstanceName" TextChanged="NameChanged"/>
   <TextBlock Text="下载任务会记住所选目录、Java 和下载源；已存在的实例不会被覆盖。" Style="{StaticResource Hint}" Margin="0,9,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="GameStatus" TextWrapping="Wrap" Margin="0,16,0,10"/><Button x:Name="InstallGameButton" Content="加入下载队列  →" Style="{StaticResource Primary}" Click="InstallGame" HorizontalAlignment="Right" IsEnabled="False"/>
  </StackPanel></local:MaterialBorder></ScrollViewer>
  <Grid Grid.Row="3" x:Name="PacksPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="CatalogSearchLabel" Text="搜索整合包" FontSize="11" Margin="0,0,0,5"/>
    <Grid Grid.Row="1" Margin="0,0,10,0"><TextBox x:Name="PackQuery" ToolTip="整合包名称，Ctrl+F 定位搜索" AutomationProperties.Name="搜索整合包" KeyDown="SearchKey" Padding="13,9"/><TextBlock x:Name="PackQueryPlaceholder" Text="输入名称，或直接浏览全部…" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PackQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <Button x:Name="SearchButton" Grid.Row="1" Grid.Column="1" Content="搜索" Click="SearchClick" Style="{StaticResource Primary}" MinWidth="76"/>
    <Button x:Name="CancelSearchButton" Grid.Row="1" Grid.Column="2" Content="取消" Click="CancelSearch" Visibility="Collapsed" ToolTip="取消当前搜索（Esc）" Margin="8,0,0,0"/>
    <Button Grid.Row="1" Grid.Column="3" Content="重置" Click="ResetSearch" Margin="8,0,0,0"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,10,0,10">
    <StackPanel x:Name="ContentTargetPanel" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="安装到实例" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="ContentTargetBox" DisplayMemberPath="Display" SelectionChanged="ContentTargetChanged" AutomationProperties.Name="资源安装目标实例"/><TextBlock x:Name="ContentTargetHint" Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
    <WrapPanel VerticalAlignment="Center"><StackPanel Margin="0,0,12,0"><TextBlock Text="Minecraft 版本" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="PackGameVersion" Width="174" IsEditable="True" IsTextSearchEnabled="True" KeyDown="SearchKey" AutomationProperties.Name="Minecraft 版本，可输入或下拉选择，默认全部"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock x:Name="CatalogLoaderLabel" Text="加载器" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="PackLoader" Width="145"/></StackPanel><StackPanel><TextBlock Text="排序" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="PackSortBox" Width="145"/></StackPanel></WrapPanel><TextBlock x:Name="PackSummary" AutomationProperties.LiveSetting="Polite" Text="Modrinth 整合包 · 输入名称或直接搜索" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
   <Grid Grid.Row="2">
    <ListBox x:Name="PackResults" Background="Transparent" BorderThickness="0" SelectionMode="Single" SelectionChanged="PackSelectionChanged" MouseDoubleClick="OpenPackDoubleClick" KeyDown="PackKey" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Project.Title}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <local:MaterialBorder x:Name="Row" Area="Panels" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,9"><ContentPresenter/></local:MaterialBorder>
       <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/><Setter TargetName="Row" Property="Padding" Value="11,8"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Grid MinHeight="54"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <local:PackArtwork IconUrl="{Binding Project.IconUrl}" Badge="{Binding Project.Badge}" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="18"/><RowDefinition Height="18"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Project.Title}" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Title}"/>
        <DockPanel Grid.Row="1" LastChildFill="True">
         <ItemsControl ItemsSource="{Binding Tags}" DockPanel.Dock="Left" Margin="0,0,5,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource AccentSoft}" CornerRadius="3" Margin="0,1,4,1" Padding="4,0"><TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{Binding Project.Description}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Description}"/>
        </DockPanel>
        <Grid Grid.Row="2" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal" Margin="0,0,8,0"><Path Data="M1,3 L6,0 11,3 11,9 6,12 1,9 Z M4,5 L6,4 8,5 8,7 6,8 4,7 Z" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Compatibility}" ToolTip="{Binding FullCompatibility}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="210"/></StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal"><Path Data="M6,0 V8 M2,5 L6,9 10,5 M0,10 V13 H12 V10" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Downloads}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" ToolTip="下载量"/></StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal"><Path Data="M6,12 V1 M2,5 L6,1 10,5" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Updated}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" ToolTip="{Binding Project.Updated}"/></StackPanel>
         <StackPanel Grid.Column="3" Orientation="Horizontal"><Path Data="M6,0 A6,6 0 1 1 5.99,0 M0,6 H12 M6,0 C2,3 2,9 6,12 M6,0 C10,3 10,9 6,12" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Project.SourceLabel}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"/></StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410" Margin="12"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="{Binding Visibility, ElementName=PackEmpty}"/></Style></StackPanel.Style>
     <TextBlock x:Name="PackEmpty" Text="浏览适合你的整合包" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="CatalogEmptyHint" Text="输入名称搜索，或保留全部版本，先浏览热门内容。" Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,14"/>
     <Button x:Name="BrowseCatalogButton" Content="浏览内容" Style="{StaticResource Primary}" Click="SearchClick" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="3" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="PreviousPage" Content="上一页" Click="PreviousSearch" IsEnabled="False"/><TextBlock x:Name="PackPageLabel" Text="第 1 页" Margin="12,0" VerticalAlignment="Center"/><Button x:Name="NextPage" Content="下一页" Click="NextSearch" IsEnabled="False"/></StackPanel><Button x:Name="ChoosePackButton" Content="选择版本并安装  →" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="OpenPack"/></Grid>
  </Grid>
  <Grid Grid.Row="3" x:Name="TasksPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock x:Name="TasksSummary" Text="无下载任务" VerticalAlignment="Center"/><Button Content="清除已结束" HorizontalAlignment="Right" Click="ClearTasks"/></Grid><Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate><local:MaterialBorder Area="Panels" Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,5,0,0"/><TextBlock Text="{Binding TargetDirectory}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/></Grid><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,12,0,7"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="100" Height="5" Foreground="{DynamicResource Accent}"/><Grid Margin="0,10,0,0"><TextBlock Text="{Binding Numbers}" Style="{StaticResource Hint}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding ToggleCaption}" IsEnabled="{Binding CanToggle}" Click="ToggleTask" Padding="10,6"/><Button Content="取消" IsEnabled="{Binding CanCancel}" Click="CancelTask" Margin="8,0,0,0" Padding="10,6"/></StackPanel></Grid><Expander Header="任务日志" Margin="0,8,0,0"><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="130" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Expander></StackPanel></local:MaterialBorder></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="TasksEmpty" Text="无下载任务" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid>
 </Grid>
</UserControl>
