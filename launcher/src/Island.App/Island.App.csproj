<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>岛屿启动器</AssemblyName><RootNamespace>Island.App</RootNamespace><Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Island.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Island.Core/Island.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Island.ico" /><Resource Include="Assets/InstanceIcons/*.png" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Steve.png" LogicalName="Island.App.Steve.png" /><EmbeddedResource Include="Assets/PrismaticGlass.png" LogicalName="Island.App.PrismaticGlass.png" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Island.App.Tests" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../../src/BlockDock.App/DownloadQueue.cs" Link="Downloads/DownloadQueue.cs" />
    <Compile Include="../../../src/BlockDock.App/DownloadTask.cs" Link="Downloads/DownloadTask.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../LICENSE" LogicalName="Island.App.Legal.ISLAND-LICENSE.txt" />
    <EmbeddedResource Include="../../third-party/*" LogicalName="Island.App.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildSDKsPath)/../../../LICENSE.txt" LogicalName="Island.App.Legal.DOTNET-LICENSE.txt" />
    <EmbeddedResource Include="$(MSBuildSDKsPath)/../../../ThirdPartyNotices.txt" LogicalName="Island.App.Legal.DOTNET-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <Target Name="GenerateCatalogCredential" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-CatalogCredential.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)CatalogCredential.g.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)CatalogCredential.g.cs" /></ItemGroup>
  </Target>
</Project>
