<UserControl x:Class="Island.App.InstanceSettingRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
  <StackPanel>
   <ToggleButton FocusVisualStyle="{x:Null}" x:Name="Toggle" HorizontalContentAlignment="Stretch" MinHeight="56" Background="Transparent" BorderThickness="0" Padding="16,12" Checked="ToggleChanged" Unchecked="ToggleChanged">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>

      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderSurface" Property="Opacity" Value="0.55"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></ToggleButton.Template>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleText" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="DescriptionText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,8,0" Visibility="Collapsed"/></StackPanel>
     <TextBlock x:Name="SummaryText" Grid.Column="1" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,12,0"/>
     <TextBlock x:Name="Arrow" Grid.Column="2" Text="⌄" Foreground="{DynamicResource Muted}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </ToggleButton>
   <Border x:Name="Details" Visibility="Collapsed" Padding="16,4,16,18"><ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch"/></Border>
  </StackPanel>
 </Border>
</UserControl>