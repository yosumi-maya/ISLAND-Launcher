<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Island.App">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml" /></ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="Ink" Color="#263A34" /><SolidColorBrush x:Key="Muted" Color="#7A847D" /><SolidColorBrush x:Key="Accent" Color="#2D7568" />
 <SolidColorBrush x:Key="Line" Color="#D3DFD8" /><SolidColorBrush x:Key="PrimaryHover" Color="#2D5A46" /><SolidColorBrush x:Key="PrimaryPressed" Color="#295340" /><SolidColorBrush x:Key="OnPrimaryHover" Color="White" /><SolidColorBrush x:Key="OnPrimaryPressed" Color="White" /><SolidColorBrush x:Key="NoticeBackground" Color="#E8F0ED" /><SolidColorBrush x:Key="NoticeInk" Color="#3B594E" />
 <SolidColorBrush x:Key="OnAccent" Color="White" /><SolidColorBrush x:Key="AccentInk" Color="#28695E" /><SolidColorBrush x:Key="AccentSelectionInk" Color="#28695E" />
 <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" /><SolidColorBrush x:Key="SidebarBackground" Color="#F3F4F6" /><SolidColorBrush x:Key="ContentBackground" Color="#F3F4F6" /><SolidColorBrush x:Key="Surface" Color="White" />
 <SolidColorBrush x:Key="AccentSoft" Color="#ECF3F1" /><SolidColorBrush x:Key="AccentSelection" Color="#D3E0DF" /><SolidColorBrush x:Key="HoverBackground" Color="#E6EAEC" /><SolidColorBrush x:Key="StatusAccent" Color="#2D7568" /><SolidColorBrush x:Key="AccentHover" Color="#E6EADF" />
 <SolidColorBrush x:Key="SelectionBackground" Color="#ECF3F1" /><SolidColorBrush x:Key="SelectionBorder" Color="#518165" /><SolidColorBrush x:Key="Focus" Color="#638F70" /><SolidColorBrush x:Key="SelectionFill" Color="#AAC6AD" />
 <SolidColorBrush x:Key="HeroBackground" Color="#ECF3F1" /><SolidColorBrush x:Key="HeroSurface" Color="#FFFFFF" /><SolidColorBrush x:Key="HeroBorder" Color="#3B6050" /><SolidColorBrush x:Key="HeroText" Color="#22352E" /><SolidColorBrush x:Key="HeroMuted" Color="#52645C" />
 <SolidColorBrush x:Key="ScrollThumb" Color="#BCC9B6" /><SolidColorBrush x:Key="ScrollHover" Color="#8CA383" />
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource WindowBackground}" /></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
 <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="21" /></Style>
 <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Focus}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentInk}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TrafficLight" TargetType="Button">
  <Setter Property="Width" Value="20" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent"><Ellipse x:Name="Dot" Width="12" Height="12" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0.8" /><ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1" /></DataTrigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="0.65" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Dot" Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryHover}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryPressed}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryPressed}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CardFavorite" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger></Style.Triggers></Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="CaretBrush" Value="{DynamicResource Ink}" /><Setter Property="MinHeight" Value="38" /><Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="ContextMenu" Value="{DynamicResource TextEditingMenu}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,8" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="{DynamicResource SelectionFill}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" /></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="AcceptsReturn" Value="True"><Setter Property="VerticalContentAlignment" Value="Top" /></Trigger></Style.Triggers></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="24" /></Style>
 <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Padding" Value="17,13" /><Setter Property="Margin" Value="12,3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSelection}" /><Setter Property="Foreground" Value="{DynamicResource AccentSelectionInk}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="IsChecked" Value="False" /></MultiTrigger.Conditions><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentHover}" /></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Filter" TargetType="RadioButton" BasedOn="{StaticResource Nav}"><Setter Property="Padding" Value="13,7" /><Setter Property="Margin" Value="0,0,6,0" /></Style>
 <Style x:Key="CatalogTab" TargetType="RadioButton" BasedOn="{StaticResource Filter}"><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Border x:Name="TabBody" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="ActiveLine" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" CornerRadius="1.5" Margin="12,0" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBody" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="TabBody" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
 <Style x:Key="InstanceCardItem" TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid local:CardMotion.IsCard="True"><local:MaterialBorder x:Name="B" Background="{DynamicResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}" Area="Instances"><ContentPresenter /></local:MaterialBorder></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentInk}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="InstalledModRow" TargetType="ListViewItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Margin" Value="0,0,4,2" />
  <Setter Property="Padding" Value="8,5" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListViewItem">
     <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBackground}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="InstalledModAction" TargetType="Button" BasedOn="{StaticResource Quiet}">
  <Setter Property="Width" Value="30" />
  <Setter Property="Height" Value="32" />
  <Setter Property="MinHeight" Value="0" />
  <Setter Property="Padding" Value="0" />
  <Setter Property="Margin" Value="1,0,0,0" />
  <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
 </Style>
 <Style x:Key="InstalledModActionIcon" TargetType="Path">
  <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  <Setter Property="StrokeThickness" Value="1.5" />
  <Setter Property="StrokeStartLineCap" Value="Round" />
  <Setter Property="StrokeEndLineCap" Value="Round" />
  <Setter Property="StrokeLineJoin" Value="Round" />
  <Setter Property="Stretch" Value="None" />
  <Setter Property="IsHitTestVisible" Value="False" />
 </Style>
 <DataTemplate x:Key="InstalledModTemplate">
  <Grid ToolTip="{Binding File.Path}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Border Width="34" Height="34" CornerRadius="7" HorizontalAlignment="Left" Background="{DynamicResource SelectionBackground}">
    <Grid>
     <Path x:Name="ModFallbackIcon" Visibility="Collapsed" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
           Fill="Transparent" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"
           Data="M12,1 L22,7 L22,18 L12,24 L2,18 L2,7 Z M2,7 L12,13 L22,7 M12,13 L12,24" />
     <Image Source="{Binding Icon}" Stretch="Uniform" />
    </Grid>
   </Border>
   <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
     <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding VersionLabel, Mode=OneWay}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource Muted}" />
    </TextBlock>
    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
   </StackPanel>
   <TextBlock x:Name="ModDisabledBadge" Grid.Column="2" Text="已停用" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
   <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
    <Button x:Name="ModDownloadButton" Tag="download" Style="{StaticResource InstalledModAction}" AutomationProperties.Name="打开模组下载页" ToolTip="打开模组下载页">
     <Path Style="{StaticResource InstalledModActionIcon}" Data="M1,8 A7,7 0 1 0 15,8 A7,7 0 1 0 1,8 M8,7 L8,12 M8,4.3 L8,4.6" />
    </Button>
    <Button x:Name="ModLocateButton" Tag="locate" Style="{StaticResource InstalledModAction}" AutomationProperties.Name="在资源管理器定位模组" ToolTip="在资源管理器定位模组">
     <Path Style="{StaticResource InstalledModActionIcon}" Data="M1,13 L1,4 L6,4 L8,6 L15,6 L15,8 M1,13 L4,8 L16,8 L13,13 Z" />
    </Button>
    <Button x:Name="ModToggleButton" Tag="toggle" Style="{StaticResource InstalledModAction}" AutomationProperties.Name="停用模组" ToolTip="停用模组">
     <Path x:Name="ModToggleGlyph" Style="{StaticResource InstalledModActionIcon}" Data="M1,8 A7,7 0 1 0 15,8 A7,7 0 1 0 1,8 M5,8 L11,8" />
    </Button>
    <Button x:Name="ModDeleteButton" Tag="delete" Style="{StaticResource InstalledModAction}" AutomationProperties.Name="删除模组" ToolTip="删除模组">
     <Path Style="{StaticResource InstalledModActionIcon}" Data="M1,4 L15,4 M5,4 L5,2 L11,2 L11,4 M3,4 L4,15 L12,15 L13,4 M6,7 L6,12 M10,7 L10,12" />
    </Button>
   </StackPanel>
  </Grid>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding File.Enabled}" Value="False">
    <Setter TargetName="ModDisabledBadge" Property="Visibility" Value="Visible" />
    <Setter TargetName="ModToggleButton" Property="ToolTip" Value="启用模组" />
    <Setter TargetName="ModToggleButton" Property="AutomationProperties.Name" Value="启用模组" />
    <Setter TargetName="ModToggleGlyph" Property="Data" Value="M1,8 A7,7 0 1 0 15,8 A7,7 0 1 0 1,8 M5,8 L11,8 M8,5 L8,11" />
   </DataTrigger>
   <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="ModFallbackIcon" Property="Visibility" Value="Visible" /></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <Style x:Key="CatalogResultRow" TargetType="ListBoxItem">
  <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="12,9"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <local:MaterialBorder x:Name="Row" Area="Panels" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
   </local:MaterialBorder>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>

    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.6"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <local:ReleaseDetailsConverter x:Key="ReleaseDetails"/>
 <DataTemplate x:Key="CatalogReleaseTemplate">
  <Grid MinHeight="40" ToolTip="{Binding Display}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    <TextBlock Text="{Binding Converter={StaticResource ReleaseDetails}}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding Published, StringFormat={}{0:yyyy/MM/dd}}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
  </Grid>
 </DataTemplate>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
    <ScrollViewer x:Name="PART_ContentHost"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
