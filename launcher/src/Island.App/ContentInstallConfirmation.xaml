<UserControl x:Class="Island.App.ContentInstallConfirmation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Island.App">
 <Grid Margin="26,4,26,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock x:Name="InstallHeading" Text="确认模组安装" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock x:Name="InstallIntroduction" Text="即将安装以下模组到此文件夹" Margin="0,12,0,8"/>
   <TextBox x:Name="InstallDestination" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="实际安装文件夹，可复制"/>
   <TextBlock x:Name="InstallInstance" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,7,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="安装清单" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Grid.Column="1" x:Name="DetectAgain" Content="重新检测已安装资源" Click="DetectAgainClick" Padding="12,7"/>
  </Grid>
  <ListBox Grid.Row="2" x:Name="InstallChoices" HorizontalContentAlignment="Stretch" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="模组本体与可勾选的前置列表">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CatalogResultRow}"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <CheckBox IsChecked="{Binding Install, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="{Binding CheckLabel}" ToolTip="{Binding CheckLabel}"/>
     <StackPanel Grid.Column="1">
      <DockPanel LastChildFill="True"><Border DockPanel.Dock="Left" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"><TextBlock Text="{Binding Role}" FontSize="11" Foreground="{DynamicResource AccentInk}"/></Border><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/></DockPanel>
      <TextBlock Text="{Binding FileLabel}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/>
      <TextBlock Text="{Binding Detection}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ExistingLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExistingPath}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ExistingLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <ProgressBar x:Name="DetectionProgress" IsIndeterminate="True" Height="3" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
   <TextBlock x:Name="SelectionSummary" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="SelectionHint" Text="前置可取消勾选；未勾选的项目不会下载。" Style="{StaticResource Hint}" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</UserControl>
