<UserControl x:Class="Island.App.MemoryAllocationEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <UserControl.Resources>
  <Style x:Key="MemoryChoice" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Ellipse x:Name="Ring" Width="16" Height="16" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" />
     <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed" VerticalAlignment="Center" />
     <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" /></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Focus}" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="StrokeThickness" Value="2" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MemoryTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="2" Background="{DynamicResource Line}" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MemorySlider" TargetType="Slider">
   <Setter Property="Height" Value="26" /><Setter Property="Background" Value="Transparent" /><Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="{TemplateBinding Background}" Margin="6,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False" Orientation="Horizontal">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MemoryTrackButton}" /></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="12" Height="26"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="ThumbDot" Width="10" Height="10" Fill="{DynamicResource Accent}" VerticalAlignment="Center" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbDot" Property="Width" Value="12" /><Setter TargetName="ThumbDot" Property="Height" Value="12" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MemoryTrackButton}" /></Track.IncreaseRepeatButton>
    </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="内存分配" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
  <Grid Margin="10,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <RadioButton x:Name="AutomaticChoice" Content="自动配置" GroupName="MemoryMode" Style="{StaticResource MemoryChoice}" Checked="ChangeMode" IsChecked="True" />
   <RadioButton x:Name="CustomChoice" Grid.Row="1" Content="自定义" GroupName="MemoryMode" Style="{StaticResource MemoryChoice}" Checked="ChangeMode" />
   <Slider x:Name="AllocationSlider" Grid.Row="1" Grid.Column="1" Minimum="512" Maximum="65536" SmallChange="256" LargeChange="1024" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="ChangeLimit" Style="{StaticResource MemorySlider}" AutomationProperties.Name="自定义游戏内存（MB）" />
  </Grid>
  <ContentControl x:Name="OptimizationHost" HorizontalContentAlignment="Stretch" Margin="10,0,10,0" />
  <StackPanel Margin="10,10,10,0" ToolTipService.ShowDuration="15000">
   <StackPanel.ToolTip><TextBlock x:Name="AllocationHint" MaxWidth="360" TextWrapping="Wrap" /></StackPanel.ToolTip>
   <Grid Margin="0,0,0,3"><TextBlock Text="已使用内存" Foreground="{DynamicResource Muted}" FontSize="11" /><TextBlock Text="游戏分配" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" /></Grid>
   <Grid x:Name="UsageBar" Height="4" Background="{DynamicResource Line}" ClipToBounds="True">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="UsedColumn" /><ColumnDefinition x:Name="GameColumn" /><ColumnDefinition x:Name="FreeColumn" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Accent}" /><Border Grid.Column="1" Background="{DynamicResource Accent}" Opacity="0.3" />
   </Grid>
   <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="UsedValue" FontSize="16" Text="— GB / — GB" />
    <TextBlock x:Name="AllocationValue" Grid.Column="1" FontSize="16" Text="— GB（可用 — GB）" TextAlignment="Right" />
   </Grid>
  </StackPanel>
 </StackPanel>
</UserControl>
